<!DOCTYPE html>
<html lang="{{ locale }}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ title }} – {{ site.name }}</title>
    <meta name="robots" content="noindex,nofollow">
    <style>{{ cssVariables|raw }}</style>
    {% if themeCssUrl %}
        <link rel="stylesheet" href="{{ themeCssUrl }}">
    {% endif %}
    <style>
        .account-panel { max-width: 36rem; margin: 0 auto; }
        .account-panel .card { background: var(--color-surface-elevated, #fff); border: 1px solid var(--color-border, #d6d3d1); border-radius: var(--radius-md, 8px); padding: 1.25rem; margin-bottom: 1rem; }
        .account-panel .card-danger { border-color: color-mix(in srgb, #9f1239 35%, var(--color-border, #d6d3d1)); }
        .account-panel h1 { font-size: 1.35rem; margin: 0 0 1rem; }
        .account-panel h2 { font-size: 1.1rem; margin: 0 0 .5rem; }
        .account-panel label { display: block; font-weight: 600; margin: .75rem 0 .3rem; }
        .account-panel input,
        .account-panel select,
        .account-panel textarea { width: 100%; padding: .5rem .6rem; border: 1px solid var(--color-border, #d6d3d1); border-radius: 6px; font: inherit; box-sizing: border-box; background: #fff; }
        .account-panel select { appearance: none; background-image: linear-gradient(45deg, transparent 50%, var(--color-text-muted, #57534e) 50%), linear-gradient(135deg, var(--color-text-muted, #57534e) 50%, transparent 50%); background-position: calc(100% - 1.05rem) calc(50% - .12rem), calc(100% - .7rem) calc(50% - .12rem); background-size: .35rem .35rem, .35rem .35rem; background-repeat: no-repeat; padding-right: 2rem; cursor: pointer; }
        .account-panel textarea { min-height: 7rem; resize: vertical; line-height: 1.5; }
        .account-panel button, .account-panel .btn { display: inline-block; background: var(--color-brand-primary, #1b4d3e); color: #fff; border: 0; border-radius: 6px; padding: .55rem .9rem; text-decoration: none; cursor: pointer; font: inherit; }
        .account-panel .btn-danger { background: #9f1239; }
        .account-panel .btn-muted { background: #78716c; }
        .account-panel .muted { color: var(--color-text-muted, #57534e); }
        .account-panel .error { color: #9f1239; margin: 0 0 1rem; }
        .account-panel .flash { background: #ecfdf5; border: 1px solid #a7f3d0; color: #065f46; padding: .75rem 1rem; border-radius: 8px; margin: 0 0 1rem; font-weight: 600; }
        .account-panel .links { margin-top: 1rem; font-size: .95rem; }
        .account-panel .top { display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem; margin-bottom: 1rem; }
        .account-panel a { color: var(--color-brand-primary, #1b4d3e); }
        .account-panel .account-sections { display: flex; flex-wrap: wrap; gap: .65rem 1rem; margin: 0 0 1rem; padding: 0 0 .85rem; border-bottom: 1px solid var(--color-border, #d6d3d1); }
        .account-panel .account-sections a { text-decoration: none; font-weight: 600; font-size: .92rem; }
        .account-panel .totp-qr { display: inline-block; margin: .75rem 0; padding: .5rem; background: #fff; border: 1px solid var(--color-border, #d6d3d1); border-radius: 8px; }
        .account-panel .totp-qr svg { display: block; width: 200px; height: 200px; }
        .account-panel code { font-size: .85em; word-break: break-all; }
        .account-modal {
            border: 1px solid var(--color-border, #d6d3d1);
            border-radius: 10px;
            padding: 0;
            max-width: 26rem;
            width: calc(100% - 2rem);
            box-shadow: 0 18px 48px rgba(28, 25, 23, .22);
        }
        .account-modal::backdrop { background: rgba(28, 25, 23, .45); }
        .account-modal form { margin: 0; padding: 1.25rem 1.35rem 1.35rem; }
        .account-modal h2 { margin: 0 0 .5rem; font-size: 1.15rem; }
        .account-modal p { margin: 0 0 .75rem; }
        .account-modal__actions {
            display: flex; justify-content: flex-end; gap: .5rem; flex-wrap: wrap;
            margin-top: 1.15rem;
        }
    </style>
    {{ slot('theme.head') }}
</head>
<body class="theme-shell theme-editorial layout-nav-{{ layout.navPosition|default('right') }} layout-footer-{{ layout.footerPosition|default('split') }}{% if layout.logoInNav|default(false) %} layout-logo-nav{% endif %}">
<header class="theme-header">
    <a class="theme-brand" href="{{ homeUrl }}">
        {% if logoUrl and not (layout.logoInNav|default(false)) %}
            <img src="{{ logoUrl }}" alt="">
        {% endif %}
        {% if layout.showSiteName|default(true) %}
            <span>{{ site.name }}</span>
        {% else %}
            <span class="visually-hidden">{{ site.name }}</span>
        {% endif %}
    </a>
    <div class="theme-header-navs">
        <nav class="theme-nav" aria-label="{{ themeUi.ariaPrimary|default('Main navigation') }}">
            {% if layout.logoInNav|default(false) and logoUrl %}
                <a class="theme-nav-logo" href="{{ homeUrl }}"><img src="{{ logoUrl }}" alt="{{ site.name }}"></a>
            {% endif %}
            {% for item in primaryNav|default([]) %}
                {% if item.children is defined and item.children|length > 0 %}
                    <span class="theme-nav-item has-children">
                        <a href="{{ item.url }}">{{ item.label }}</a>
                        <span class="theme-nav-sub">
                            {% for child in item.children %}
                                <a href="{{ child.url }}">{{ child.label }}</a>
                            {% endfor %}
                        </span>
                    </span>
                {% else %}
                    <a href="{{ item.url }}">{{ item.label }}</a>
                {% endif %}
            {% endfor %}
            {% for item in accountNav|default([]) %}
                <a class="theme-nav-account" href="{{ item.url }}">{{ item.label }}</a>
            {% endfor %}
        </nav>
        <nav class="theme-nav theme-nav--locales" aria-label="{{ themeUi.ariaLocales|default('Languages') }}">
            {% for alt in alternates %}
                {% if alt.published|default(true) %}
                    <a href="{{ alt.url }}"{% if alt.locale == locale %} aria-current="page" class="is-active"{% endif %}>{{ alt.locale|upper }}</a>
                {% else %}
                    <span class="is-unavailable" title="{{ alt.unavailableLabel|default(themeUi.unavailable|default('coming soon')) }}">{{ alt.locale|upper }}</span>
                {% endif %}
            {% endfor %}
        </nav>
    </div>
    {{ slot('theme.header-actions') }}
</header>
<main class="theme-main">
    <div class="account-panel">
        {{ contentHtml|raw }}
    </div>
</main>
<footer class="theme-footer">
    <nav class="theme-footer-nav" aria-label="{{ themeUi.ariaFooter|default('Footer') }}">
        {% if footerNav|default([])|length > 0 %}
            {% for item in footerNav %}
                <a href="{{ item.url }}">{{ item.label }}</a>
                {% if item.children is defined %}
                    {% for child in item.children %}
                        <a href="{{ child.url }}">{{ child.label }}</a>
                    {% endfor %}
                {% endif %}
            {% endfor %}
        {% endif %}
        {{ slot('theme.footer-links') }}
    </nav>
    {% set showFooterSite = layout.footerShowSiteName|default(true) %}
    {% set showFooterTheme = layout.footerShowThemeName|default(true) %}
    {% if showFooterSite or showFooterTheme %}
        <p class="theme-footer-meta">{% if showFooterSite %}{{ site.name }}{% endif %}{% if showFooterSite and showFooterTheme %} · {% endif %}{% if showFooterTheme %}{{ themeName }}{% endif %}</p>
    {% endif %}
</footer>
{{ slot('theme.footer') }}
</body>
</html>

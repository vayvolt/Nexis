<!DOCTYPE html>
<html lang="{{ uiLocale|default('de') }}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex">
    <title>{{ errorTitle|default('Maintenance') }}</title>
    <style>{{ cssVariables|raw }}</style>
    {% if themeCssUrl %}
        <link rel="stylesheet" href="{{ themeCssUrl }}">
    {% endif %}
    <style>
        .nx-maintenance { max-width: 36rem; margin: 0 auto; padding: 3.5rem 1.25rem; }
        .nx-maintenance__eyebrow {
            display: inline-block; font: 700 .75rem/1 system-ui, sans-serif; letter-spacing: .08em;
            text-transform: uppercase; opacity: .7; margin: 0 0 .85rem;
        }
        .nx-maintenance__meta { margin-top: 1rem; font-size: .9rem; opacity: .65; }
    </style>
</head>
<body class="theme-shell">
<main class="theme-main nx-maintenance">
    <span class="nx-maintenance__eyebrow">503</span>
    <h1>{{ errorHeading|default(errorTitle|default('Maintenance')) }}</h1>
    <p>{{ message }}</p>
    {% if requestId %}
        <p class="nx-maintenance__meta">Request-ID: {{ requestId }}</p>
    {% endif %}
</main>
</body>
</html>

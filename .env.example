# Production template — copy to `.env` and fill in values.
# The web installer (`/install`) writes `.env` automatically.

APP_ENV=production
APP_DEBUG=false
APP_URL=https://example.com
APP_KEY=change-me-to-a-long-random-string

# Comma-separated REMOTE_ADDR values allowed to trust X-Forwarded-Proto / X-Forwarded-For.
# Leave empty unless TLS terminates at a reverse proxy. Use * only behind a locked-down edge.
TRUSTED_PROXIES=

# Optional Ed25519 public key (hex) for signed plugin ZIPs. Empty = signature check skipped.
PLUGIN_TRUST_PUBLIC_KEY=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nexis
DB_USERNAME=nexis
DB_PASSWORD=

# Prefer smtp (or mail) in production. log only writes to files + mail_log (no real delivery).
MAIL_TRANSPORT=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME=Nexis

# Media uploads (bytes / width*height for images). Defaults: 10 MiB / 25 MP.
MEDIA_MAX_BYTES=10485760
MEDIA_MAX_PIXELS=25000000

# Optional: absolute path to mysqldump if not on PATH
# MYSQLDUMP_PATH=/usr/bin/mysqldump
